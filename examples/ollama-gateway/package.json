{
  "name": "@company/ai-assistant-ollama-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Local HTTP gateway bridging HttpGatewayProvider to Ollama",
  "main": "server.js",
  "scripts": {
    "start": "OLLAMA_MODEL=llama3.2:1b node server.js",
    "start:llama": "OLLAMA_MODEL=llama3.2:1b node server.js",
    "start:llama3": "OLLAMA_MODEL=llama3.2 node server.js",
    "health": "curl -s http://127.0.0.1:8787/health | python3 -m json.tool"
  },
  "engines": {
    "node": ">=18"
  }
}
